--WINDOW FUNCTIONS
--1.Assign row numbers to each order.
SELECT * FROM ORDERS;
SELECT ROWNUM AS ROWNUMBER,ORDER_ID,CUSTOMER_ID,CUSTOMER_NAME FROM ORDERS; 
--2.Find total sales per order.
SELECT ORDER_ID, SUM(UNIT_PRICE*QUANTITY) AS TOTAL_SALES FROM ORDERS GROUP BY ORDER_ID;
--3.Dense rank products by sales.
SELECT 
       PRODUCT_CATEGORY,
       SUM(UNIT_PRICE * QUANTITY) AS TOTAL_SALES,
       DENSE_RANK() OVER (ORDER BY SUM(UNIT_PRICE * QUANTITY) DESC) AS SALES_RANK
FROM ORDERS
GROUP BY PRODUCT_CATEGORY;
--4.Find running total of sales.
SELECT ORDER_ID,
       SUM(UNIT_PRICE*QUANTITY) AS ORDER_SALES,
       SUM(SUM(UNIT_PRICE * QUANTITY))
                OVER(ORDER BY ORDER_ID)AS RUNNING_TOTAL
FROM ORDERS
GROUP BY ORDER_ID
ORDER BY ORDER_ID;
--5.Calculate cumulative sum by month.
SELECT 
      TO_CHAR(ORDER_DATE, 'YYYY-MM') AS MONTH,
      SUM(UNIT_PRICE*QUANTITY) AS MONTHLY_SALES,
      SUM(SUM(UNIT_PRICE*QUANTITY))
            OVER(ORDER BY TO_CHAR(ORDER_DATE, 'YYYY-MM')) AS CUMULATIVE_SALES
FROM ORDERS
GROUP BY TO_cHAR(ORDER_DATE, 'YYYY-MM')
ORDER BY MONTH;
--6.Find moving average of last 3 days.
SELECT 
     ORDER_DATE,
     SUM(UNIT_PRICE*QUANTITY) AS DAILY_SALES,
     AVG(SUM(UNIT_PRICE*QUANTITY))
            OVER(
                ORDER BY ORDER_DATE
                ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
                ) AS MOVING_AVG_3DAYS
FROM ORDERS
GROUP BY ORDER_DATE
ORDER BY ORDER_DATE;
--7.Calculate lag of previous day sales.
SELECT 
     ORDER_DATE,
     SUM(UNIT_PRICE*QUANTITY) AS DAILY_SALES,
     LAG(SUM(UNIT_PRICE*QUANTITY))
        OVER(ORDER BY ORDER_DATE) AS PREVIOUS_DAY_SALES
FROM ORDERS
GROUP BY ORDER_DATE
ORDER BY ORDER_DATE;
--8.Calculate lead of next day sales.
SELECT 
     ORDER_DATE,
     SUM(UNIT_PRICE*QUANTITY) AS DAILY_SALES,
     LEAD(SUM(UNIT_PRICE*QUANTITY))
        OVER(ORDER BY ORDER_DATE) AS PREVIOUS_DAY_SALES
FROM ORDERS
GROUP BY ORDER_DATE
ORDER BY ORDER_DATE;
--9.Find difference between current and previous sale.
SELECT 
     ORDER_DATE,
     SUM(UNIT_PRICE*QUANTITY) AS DAILY_SALES,
     LAG(SUM(UNIT_PRICE*QUANTITY))
        OVER(ORDER BY ORDER_DATE) AS PREVIOUS_DAY_SALES,
     SUM(UNIT_PRICE * QUANTITY)
        -LAG(SUM(UNIT_PRICE*QUANTITY))
        OVER(ORDER BY ORDER_DATE) AS SALES_DIFFERENCE
FROM ORDERS
GROUP BY ORDER_DATE
ORDER BY ORDER_DATE;
--10.Partition sales by region.
SELECT
     STORE_LOCATION,
     ORDER_ID,
     SUM(UNIT_PRICE*QUANTITY) AS ORDER_SALES,
     SUM(SUM(UNIT_PRICE*QUANTITY))
        OVER(PARTITION BY STORE_LOCATION) AS TOTAL_REGION_SALES
FROM ORDERS
GROUP BY STORE_LOCATION,ORDER_ID;
SELECT * FROM ORDERS;
--11.Find top 3 products per category.
SELECT product_category, total_sales
FROM (
    SELECT 
        product_category,
        SUM(unit_price * quantity) AS total_sales,
        ROW_NUMBER() OVER (
            PARTITION BY product_category
            ORDER BY SUM(unit_price * quantity) DESC
        ) rn
    FROM orders
    GROUP BY product_category
)
WHERE rn <= 3;
--12.Find bottom 2 customers by sales.
SELECT customer_id, total_sales
FROM (
    SELECT 
        customer_id,
        SUM(unit_price * quantity) AS total_sales,
        ROW_NUMBER() OVER (
            ORDER BY SUM(unit_price * quantity) ASC
        ) rn
    FROM orders
    GROUP BY customer_id
)
WHERE rn <= 2;
--13.Calculate percentage of total sales.
SELECT 
    order_id,
    SUM(unit_price * quantity) AS order_sales,
    ROUND(
        SUM(unit_price * quantity) 
        / SUM(SUM(unit_price * quantity)) OVER () * 100, 2
    ) AS percent_of_total
FROM orders
GROUP BY order_id;
--14.Calculate NTILE distribution of customers.
SELECT 
    customer_id,
    SUM(unit_price * quantity) AS total_sales,
    NTILE(4) OVER (
        ORDER BY SUM(unit_price * quantity) DESC
    ) AS sales_quartile
FROM orders
GROUP BY customer_id;
--15.Find first order per customer.
SELECT customer_id, order_id, order_date
FROM (
    SELECT 
        customer_id,
        order_id,
        order_date,
        ROW_NUMBER() OVER (
            PARTITION BY customer_id
            ORDER BY order_date ASC
        ) rn
    FROM orders
)
WHERE rn = 1;
--16.Find last order per customer.
SELECT customer_id, order_id, order_date
FROM (
    SELECT 
        customer_id,
        order_id,
        order_date,
        ROW_NUMBER() OVER (
            PARTITION BY customer_id
            ORDER BY order_date DESC
        ) rn
    FROM orders
)
WHERE rn = 1;
